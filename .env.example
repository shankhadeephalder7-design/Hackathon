# Copy this file to ".env" and fill in real values as you get them.
# Never share your .env file or commit it to GitHub.

SESSION_SECRET=replace-with-a-long-random-string

# From Google Cloud Console (console.cloud.google.com -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# From Facebook Developers (developers.facebook.com -> My Apps)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# From LinkedIn Developers (developer.linkedin.com -> My Apps)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
